# Database
POSTGRES_DB=escritoria
POSTGRES_USER=escritoria
POSTGRES_PASSWORD=escritoria_secret

# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1


# Groq API Keys (add as many as needed, will rotate automatically on quota)
GROQ_API_KEY_1=gsk_your_first_key_here
GROQ_API_KEY_2=gsk_your_second_key_here
# GROQ_API_KEY_3=gsk_your_third_key_here

# Groq model to use
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Email (SMTP - Gmail)
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Google Sign-In (ID Token flow — only the Client ID is needed, it is public by design)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
VITE_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key
# Generated by `python manage.py setup_stripe_prices`
STRIPE_PRICE_BASIC=price_your_basic_plan_price_id
STRIPE_PRICE_PREMIUM=price_your_premium_plan_price_id

